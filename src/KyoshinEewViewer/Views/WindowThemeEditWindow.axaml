                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Header="{loc:Tr QzssView.14}" Description="{loc:Tr WindowThemeEditWindow.55}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xf773;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.69}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding MarineWarningTyphoonColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.70}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding MarineWarningStormColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.71}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding MarineWarningGaleColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.72}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding MarineWarningWindColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
