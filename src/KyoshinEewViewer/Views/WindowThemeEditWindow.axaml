<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:converter="clr-namespace:KyoshinEewViewer.Converters;assembly=KyoshinEewViewer"
        xmlns:models="clr-namespace:KyoshinEewViewer.Core.Models;assembly=KyoshinEewViewer.Core"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="800" Width="500" Height="600" xmlns:loc="using:KyoshinEewViewer.Localization"
        x:Class="KyoshinEewViewer.Views.WindowThemeEditWindow"
        x:DataType="models:WindowTheme"
        d:DataContext="{x:Static models:WindowTheme.Dark}"
        Title="{loc:Tr WindowThemeEditWindow.01}" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBackgroundColor}" Foreground="{DynamicResource MainForegroundColor}">
    <Window.Styles>
        <Style Selector="Label">
            <Setter Property="Foreground" Value="{DynamicResource MainForegroundColor}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="ui|FASettingsExpander">
            <Setter Property="Margin" Value="10,3,10,0" />
        </Style>
    </Window.Styles>
    <Window.Resources>
        <converter:ColorConverter x:Key="ColorConverter" />
    </Window.Resources>

    <Grid RowDefinitions="auto,*">
        <StackPanel Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock Text="{loc:Tr Theme.Temporary}" FontSize="18" />
            <TextBlock x:Name="themeDetailText" FontSize="12" Foreground="{DynamicResource SubForegroundColor}" />
        </StackPanel>
        <StackPanel Spacing="5" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
            <Button x:Name="rollbackButton" VerticalAlignment="Stretch"
                    ToolTip.Tip="{loc:Tr WindowThemeEditWindow.02}" Padding="11">
                <ui:FASymbolIcon Symbol="Undo" FontSize="18" />
            </Button>
            <Button x:Name="saveButton" VerticalAlignment="Stretch" Classes="accent"
                    ToolTip.Tip="{loc:Tr WindowThemeEditWindow.03}" Padding="10">
                <ui:FASymbolIcon Symbol="Save" FontSize="20" />
            </Button>
        </StackPanel>
        
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <ui:FASettingsExpander Header="{loc:Tr WindowThemeEditWindow.04}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xf5b7;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>
                    <ui:FASettingsExpander.Footer>
                        <TextBox Text="{Binding Name}" Width="200" />
                    </ui:FASettingsExpander.Footer>
                </ui:FASettingsExpander>
                <ui:FASettingsExpander Header="{loc:Tr WindowThemeEditWindow.05}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xf2d0;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>
                    
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.06}" Description="{loc:Tr WindowThemeEditWindow.07}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TitleBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.08}"
                                             Description="{loc:Tr WindowThemeEditWindow.09}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ToggleSwitch OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" IsChecked="{Binding IsDark}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.10}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding MainBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.11}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding ForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.12}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding SubForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.13}" Description="{loc:Tr WindowThemeEditWindow.14}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EmphasisForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.15}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding WarningForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.16}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding WarningSubForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.17}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding WarningBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Header="{loc:Tr WindowThemeEditWindow.18}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xf2d2;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Grid Margin="5" RowDefinitions="24,*">
                            <Border Grid.Row="0" Background="{DynamicResource DockTitleBackgroundColor}" CornerRadius="4,4,0,0">
                                <TextBlock Text="{loc:Tr Wizard.SetupWizardSelectThemePagePreviewNormalDockTitle}" Margin="10,0" FontSize="18" Foreground="{DynamicResource SubForegroundColor}" HorizontalAlignment="Center" />
                            </Border>
                            <Border Grid.Row="1" Background="{DynamicResource DockBackgroundColor}" CornerRadius="0,0,4,4" ClipToBounds="True">
                                <TextBlock Margin="5" Text="{loc:Tr Wizard.SetupWizardSelectThemePagePreviewNormalDockContent}" />
                            </Border>
                        </Grid>
                        <Grid Margin="5" RowDefinitions="24,*">
                            <Border Grid.Row="0" Background="{DynamicResource DockWarningTitleBackgroundColor}" CornerRadius="4,4,0,0">
                                <TextBlock Text="{loc:Tr Wizard.SetupWizardSelectThemePagePreviewWarningDockTitle}" Margin="10,0" FontSize="18" Foreground="{DynamicResource WarningSubForegroundColor}" HorizontalAlignment="Center" />
                            </Border>
                            <Border Grid.Row="1" Background="{DynamicResource DockWarningBackgroundColor}" CornerRadius="0,0,4,4"
                                    ClipToBounds="True">
                                <TextBlock Text="{loc:Tr Wizard.SetupWizardSelectThemePagePreviewWarningDockContent}" Margin="10,5" Foreground="{DynamicResource WarningForegroundColor}"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                    
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.19}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding DockBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.20}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding DockTitleBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.21}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding DockWarningBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.22}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding DockWarningTitleBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Header="{loc:Tr Setting.Map}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xf5a0;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr Wizard.SetupWizardSelectThemePagePreviewMapJapan}" />
                            <Border BorderBrush="{DynamicResource MainForegroundColor}"
                                    Background="{DynamicResource BackgroundColor}" BorderThickness="1"
                                    HorizontalAlignment="Center" Margin="5">
                                <Canvas Width="120" Height="120">
                                    <Ellipse Canvas.Top="10" Canvas.Left="10" Width="100" Height="100" Stroke="{DynamicResource LandStrokeColor}" StrokeThickness="{DynamicResource LandStrokeThickness}" Fill="{DynamicResource LandColor}" />
                                    <Line Canvas.Top="10" Canvas.Left="10" StartPoint="85,15" EndPoint="15,85" Stroke="{DynamicResource PrefStrokeColor}" StrokeThickness="{DynamicResource PrefStrokeThickness}" />
                                    <Line Canvas.Top="10" Canvas.Left="10" StartPoint="15,15" EndPoint="85,85" Stroke="{DynamicResource AreaStrokeColor}" StrokeThickness="{DynamicResource AreaStrokeThickness}" />
                                </Canvas>
                            </Border>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:Tr Wizard.SetupWizardSelectThemePagePreviewMapOther}" />
                            <Border BorderBrush="{DynamicResource MainForegroundColor}"
                                    Background="{DynamicResource BackgroundColor}" BorderThickness="1"
                                    HorizontalAlignment="Center" Margin="5">
                                <Canvas Width="120" Height="120">
                                    <Ellipse Canvas.Top="10" Canvas.Left="10" Width="100" Height="100" Fill="{DynamicResource OverseasLandColor}" />
                                </Canvas>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.23}" Description="{loc:Tr WindowThemeEditWindow.24}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding OverseasLandColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.25}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding LandColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.26}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding LandStrokeColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.27}" Description="{loc:Tr WindowThemeEditWindow.28}">
                        <ui:FASettingsExpanderItem.Footer>
                            <DockPanel MinWidth="250">
                                <TextBlock Text="{Binding LandStrokeThickness, StringFormat={}{0:0.00}}"
                                            TextAlignment="Right" VerticalAlignment="Center" Width="45" DockPanel.Dock="Right" />
                                <Slider Minimum="0" Maximum="3" Value="{Binding LandStrokeThickness}"
                                        TickFrequency="0.02" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            </DockPanel>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.29}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding PrefStrokeColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.30}" Description="{loc:Tr WindowThemeEditWindow.28}">
                        <ui:FASettingsExpanderItem.Footer>
                            <DockPanel MinWidth="250">
                                <TextBlock Text="{Binding PrefStrokeThickness, StringFormat={}{0:0.00}}"
                                            TextAlignment="Right" VerticalAlignment="Center" Width="45" DockPanel.Dock="Right" />
                                <Slider Minimum="0" Maximum="3" Value="{Binding PrefStrokeThickness}"
                                        TickFrequency="0.02" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            </DockPanel>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.31}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AreaStrokeColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.32}" Description="{loc:Tr WindowThemeEditWindow.28}">
                        <ui:FASettingsExpanderItem.Footer>
                            <DockPanel MinWidth="250">
                                <TextBlock Text="{Binding AreaStrokeThickness, StringFormat={}{0:0.00}}"
                                            TextAlignment="Right" VerticalAlignment="Center" Width="45" DockPanel.Dock="Right" />
                                <Slider Minimum="0" Maximum="3" Value="{Binding AreaStrokeThickness}"
                                        TickFrequency="0.02" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            </DockPanel>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Header="{loc:Tr Series.Earthquake}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xf05a;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>
                    
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.33}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EarthquakeHypocenterBorderColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.34}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EarthquakeHypocenterColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Header="{loc:Tr Setting.Eew}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xe3b1;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>
                    
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.35}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewForecastHypocenterBorderColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.36}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewForecastHypocenterColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.37}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewWarningHypocenterBorderColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.38}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewWarningHypocenterColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.39}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ToggleSwitch OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" IsChecked="{Binding IsEewHypocenterBlinkAnimation}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.40}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewForecastPWaveColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.41}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewForecastSWaveColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.42}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ToggleSwitch OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" IsChecked="{Binding IsEewForecastSWaveGradient}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.43}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewWarningPWaveColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.44}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewWarningSWaveColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.45}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ToggleSwitch OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" IsChecked="{Binding IsEewWarningSWaveGradient}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Header="{loc:Tr Series.Tsunami}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xe515;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>
                    
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.46}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiForecastColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.47}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiForecastForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.48}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiAdvisoryColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.49}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiAdvisoryForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.50}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiWarningColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.51}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiWarningForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.52}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiMajorWarningColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.53}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiMajorWarningForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Header="{loc:Tr WindowThemeEditWindow.54}" Description="{loc:Tr WindowThemeEditWindow.55}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xf770;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>
                    
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.56}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AshfallLight, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.57}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AshfallLightForeground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.58}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AshfallModerate, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.59}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AshfallModerateForeground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.60}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AshfallHeavy, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.61}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AshfallHeavyForeground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.62}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding SmallVolcanicBombFall, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.63}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding SmallVolcanicBombFallForeground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Header="{loc:Tr WindowThemeEditWindow.64}" Description="{loc:Tr WindowThemeEditWindow.55}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xf0c2;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.65}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding WeatherWarningLevel5Color, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.66}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding WeatherWarningLevel4Color, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Tr WindowThemeEditWindow.67}">
