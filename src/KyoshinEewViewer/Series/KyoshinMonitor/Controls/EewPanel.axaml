<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:controls="clr-namespace:KyoshinEewViewer.CustomControl;assembly=KyoshinEewViewer.CustomControl"
			 xmlns:conv="clr-namespace:KyoshinEewViewer.Series.KyoshinMonitor.Converters;assembly=KyoshinEewViewer"
			 xmlns:local="clr-namespace:KyoshinEewViewer.Series.KyoshinMonitor.Models;assembly=KyoshinEewViewer"
			 xmlns:self="clr-namespace:KyoshinEewViewer.Series.KyoshinMonitor.Controls;assembly=KyoshinEewViewer"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="300"
			 x:CompileBindings="True" x:DataType="local:Eew" xmlns:loc="using:KyoshinEewViewer.Localization"
             x:Class="KyoshinEewViewer.Series.KyoshinMonitor.Controls.EewPanel"
             Design.DataContext="{x:Static local:EewMock.WARNING}">
    <Design.DesignStyle>
        <Style Selector="self|EewPanel" >
            <Setter Property="Margin" Value="10" />
        </Style>
    </Design.DesignStyle>
	<UserControl.Resources>
		<conv:IntensityToColorConverter x:Key="IntensityToColor" />
		<conv:AccuracyDetailToStringConverter x:Key="AccuracyDetailToStringConverter" />
	</UserControl.Resources>
	<UserControl.Styles>
		<Style Selector="Border.header">
			<Setter Property="Background" Value="{DynamicResource DockTitleBackgroundColor}" />
		</Style>
		<Style Selector="Border.separator">
			<Setter Property="Background" Value="{DynamicResource DockTitleBackgroundColor}" />
		</Style>
		<Style Selector="Border.header TextBlock, Border.separator TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource SubForegroundColor}" />
		</Style>
		<Style Selector="Border.container">
			<Setter Property="Background" Value="{DynamicResource DockBackgroundColor}" />
		</Style>
		<Style Selector="Panel.container">
			<Setter Property="Background" Value="{DynamicResource DockBackgroundColor}" />
		</Style>
		<Style Selector="Border.container TextBlock, Panel.container TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource MainForegroundColor}" />
		</Style>

		<Style Selector="Grid.warning Border.header">
			<Setter Property="Background" Value="{DynamicResource DockWarningTitleBackgroundColor}" />
		</Style>
		<Style Selector="Grid.warning Border.separator">
			<Setter Property="Background" Value="{DynamicResource DockWarningTitleBackgroundColor}" />
		</Style>
		<Style Selector="Grid.warning Border.header TextBlock, Grid.warning Border.separator TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource WarningSubForegroundColor}" />
		</Style>
		<Style Selector="Grid.warning Border.container">
			<Setter Property="Background" Value="{DynamicResource DockWarningBackgroundColor}" />
		</Style>
		<Style Selector="Grid.warning Panel.container">
			<Setter Property="Background" Value="{DynamicResource DockWarningBackgroundColor}" />
		</Style>
		<Style Selector="Grid.warning Border.container TextBlock, Grid.warning Panel.container TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource WarningForegroundColor}" />
		</Style>
	</UserControl.Styles>
	<Grid RowDefinitions="24,75,auto,auto" Classes.warning="{Binding IsWarning}">
		<Border Classes="header" CornerRadius="4,4,0,0">
			<Panel Margin="5,0" VerticalAlignment="Center" HorizontalAlignment="Center" TextElement.FontSize="18">
				<TextBlock IsVisible="{Binding !IsFinal}" Text="{loc:TrFormat Path=SerialNo, Key=EewPanel.F01}" />
				<TextBlock IsVisible="{Binding IsFinal}" Text="{loc:TrFormat Path=SerialNo, Key=EewPanel.F02}" />
			</Panel>
		</Border>
		<Panel Grid.Row="1" Classes="container" VerticalAlignment="Top">
			<StackPanel Margin="5,-3,0,0" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
				<TextBlock Text="{loc:TrFormat Path=Hypocenter.OccurrenceTime, Key=EewPanel.F03}" FontSize="18" />
				<TextBlock Text="{loc:Tr EewPanel.01}" FontSize="14" VerticalAlignment="Bottom" Margin="3,0,0,2" />
			</StackPanel>
			<TextBlock Margin="5,-2,75,0" Text="{loc:Tr EewPanel.02}" FontSize="16" VerticalAlignment="Top" HorizontalAlignment="Right" />
			<Viewbox Stretch="Fill" StretchDirection="DownOnly" Margin="10,17,0,0" Height="33" Width="210" VerticalAlignment="Top" HorizontalAlignment="Left">
				<TextBlock Text="{loc:Place Path=Hypocenter.Place}" FontWeight="Bold" FontSize="22" />
			</Viewbox>
			<StackPanel Margin="0,0,75,0" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
				<StackPanel IsVisible="{Binding !Hypocenter.IsTemporary}" Orientation="Horizontal">
					<TextBlock Text="{loc:Tr EewPanel.03}" VerticalAlignment="Bottom" FontSize="16" />
					<TextBlock Text="{Binding Hypocenter.Depth}" FontSize="22" VerticalAlignment="Bottom" Margin="0,0,0,-2" />
					<TextBlock Text="km" VerticalAlignment="Bottom" FontSize="16" Margin="0,0,10,0" />
					<TextBlock Text="{loc:Tr EewPanel.04}" VerticalAlignment="Bottom" FontSize="16" />
					<TextBlock Text="M" VerticalAlignment="Bottom" FontSize="22" FontWeight="Bold" Margin="0,0,0,-2" />
					<TextBlock Text="{loc:Tr EewPanel.05}" IsVisible="{Binding Hypocenter.Magnitude, Converter={x:Static ObjectConverters.IsNull}}" FontWeight="Bold" FontSize="28" Margin="0,0,0,-4" />
					<TextBlock Text="{Binding Hypocenter.Magnitude,StringFormat={}{0:f1}}" IsVisible="{Binding Hypocenter.Magnitude, Converter={x:Static ObjectConverters.IsNotNull}}" FontWeight="Bold" FontSize="28" Margin="0,0,0,-4" />
				</StackPanel>
				<TextBlock IsVisible="{Binding Hypocenter.IsTemporary}" Text="{loc:Tr EewPanel.06}" FontSize="16" Margin="5,2" />
			</StackPanel>
			<controls:IntensityIcon Intensity="{Binding MaxIntensity}" Height="75" VerticalAlignment="Top" HorizontalAlignment="Right" />
			<TextBlock Text="{loc:Tr EewPanel.07}"
						IsVisible="{Binding IsIntensityOver}"
						Foreground="{Binding MaxIntensity, Converter={StaticResource IntensityToColor}}"
						HorizontalAlignment="Right" VerticalAlignment="Bottom" />
		</Panel>
		<StackPanel Grid.Row="2">
			<Border Classes="separator" Name="AccuracyAreaHead" IsVisible="{Binding Hypocenter.Accuracy, Converter={x:Static ObjectConverters.IsNotNull}}">
				<StackPanel Orientation="Horizontal" Spacing="5" Margin="5,0">
					<TextBlock Text="{loc:Tr EewPanel.08}" FontSize="15" />
					<Panel VerticalAlignment="Bottom">
						<TextBlock IsVisible="{Binding Hypocenter.Accuracy.IsLocked}" Text="{loc:Tr EewPanel.09}" FontSize="12" />
						<TextBlock IsVisible="{Binding !Hypocenter.Accuracy.IsLocked}" Text="{loc:Tr EewPanel.10}" FontSize="12" />
					</Panel>
				</StackPanel>
			</Border>
			<Border Classes="container" Name="AccuracyAreaBody" IsVisible="{Binding Hypocenter.Accuracy, Converter={x:Static ObjectConverters.IsNotNull}}">
				<Panel Margin="10,0">
					<StackPanel IsVisible="{Binding !Hypocenter.IsTemporary}" Spacing="-5" TextElement.FontSize="13">
						<TextBlock Text="{loc:TrFormat Path=Hypocenter.Accuracy.LocationAccuracy, Key=EewPanel.F04, Converter={StaticResource AccuracyDetailToStringConverter}, ConverterParameter=epicenter}" />
						<TextBlock Text="{loc:TrFormat Path=Hypocenter.Accuracy.DepthAccuracy, Key=EewPanel.F05, Converter={StaticResource AccuracyDetailToStringConverter}, ConverterParameter=depth}" />
						<TextBlock Text="{loc:TrFormat Path=Hypocenter.Accuracy.MagnitudeAccuracy, Key=EewPanel.F06, Converter={StaticResource AccuracyDetailToStringConverter}, ConverterParameter=magnitude}" />
					</StackPanel>
					<TextBlock IsVisible="{Binding Hypocenter.IsTemporary}" Text="{loc:Tr EewPanel.11}" Margin="0,0,0,4" HorizontalAlignment="Center" FontWeight="Bold" FontSize="24" />
				</Panel>
			</Border>
			<Border Classes="separator" IsVisible="{Binding PointForecasts, Converter={x:Static ObjectConverters.IsNotNull}}">
				<Panel>
					<StackPanel Orientation="Horizontal" Spacing="5" Margin="5,0">
						<TextBlock Text="{loc:Tr EewPanel.12}" FontSize="15" />
						<TextBlock Text="{loc:TrFormat Path=PointForecasts.Length, Key=EewPanel.F07}" FontSize="12" VerticalAlignment="Bottom" />
					</StackPanel>
					<TextBlock Text="{loc:Tr EewPanel.13}" FontSize="11" Margin="3,0" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
				</Panel>
			</Border>
			<Border Classes="container" IsVisible="{Binding PointForecasts, Converter={x:Static ObjectConverters.IsNotNull}}">
				<ItemsControl ItemsSource="{Binding PointForecasts}" Margin="5,3">
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="local:EewPointForecast">
							<Panel>
								<!-- 折りたたみ表示 -->
								<Grid ColumnDefinitions="26,*,auto" IsVisible="{Binding !IsExpanded}" Margin="0,1">
									<controls:IntensityIcon Intensity="{Binding Intensity}" CornerRound="True" Height="26" VerticalAlignment="Center" />
									<StackPanel Grid.Column="1" Margin="6,0" VerticalAlignment="Center">
										<StackPanel Orientation="Horizontal" Spacing="4">
											<TextBlock Text="{Binding PointName}" FontSize="15" TextTrimming="CharacterEllipsis" />
											<TextBlock Text="{Binding RealtimeIntensityText}" FontSize="12" VerticalAlignment="Bottom" />
										</StackPanel>
										<TextBlock Text="{Binding SourceText}" FontSize="10" TextTrimming="CharacterEllipsis" />
									</StackPanel>
									<TextBlock Grid.Column="2" Text="{Binding CountdownText}" FontSize="13" TextAlignment="Right" VerticalAlignment="Center" />
								</Grid>
								<!-- 展開表示 -->
								<Border IsVisible="{Binding IsExpanded}" BorderBrush="{DynamicResource SubForegroundColor}" BorderThickness="1"
										CornerRadius="3" Padding="4,2" Margin="0,3">
									<StackPanel>
										<TextBlock Text="{Binding SourceText}" FontSize="11" />
										<Grid ColumnDefinitions="52,*,auto">
											<controls:IntensityIcon Intensity="{Binding Intensity}" CornerRound="True" Height="52" VerticalAlignment="Center" />
											<StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
												<TextBlock Text="{Binding PointName}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
												<TextBlock Text="{Binding RealtimeIntensityText}" FontSize="13" />
											</StackPanel>
											<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
												<TextBlock Text="{Binding FineCountdownText}" FontSize="38" FontWeight="Bold" />
												<TextBlock Text="{loc:Tr EewPanel.14}" FontSize="14" VerticalAlignment="Bottom" Margin="2,0,0,4" />
											</StackPanel>
										</Grid>
										<ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="4" Margin="0,2,0,0"
													 Foreground="{DynamicResource EmphasisForegroundColor}" />
									</StackPanel>
								</Border>
							</Panel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Border>
			<Border Classes="separator" IsVisible="{Binding WarningAreas, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Panel>
				    <StackPanel Orientation="Horizontal" Spacing="5" Margin="5,0">
					    <TextBlock Text="{loc:Tr EewPanel.15}" FontSize="15" />
					    <TextBlock Text="{loc:TrFormat Path=WarningAreas.Codes.Length, Key=EewPanel.F08}" FontSize="12" VerticalAlignment="Bottom" />
				    </StackPanel>
					<TextBlock FontSize="11" Margin="3,0" VerticalAlignment="Bottom" HorizontalAlignment="Right">
						<Run Text="{loc:Tr EewPanel.16}" /><Run Text="{Binding WarningAreas.DisplaySource}" /><Run Text=" (" /><Run Text="{Binding WarningAreas.SerialNo}" /><Run Text="{loc:Tr EewPanel.17}" />
					</TextBlock>
                </Panel>
			</Border>
			<Border Classes="container" IsVisible="{Binding WarningAreas, Converter={x:Static ObjectConverters.IsNotNull}}">
				<ItemsControl ItemsSource="{Binding WarningAreas.Names}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Margin="5" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="system:String">
							<TextBlock Text="{Binding}" Margin="0,0,5,0" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Border>
		</StackPanel>
        <Border Grid.Row="3" Classes="separator" CornerRadius="0,0,4,4">
			<TextBlock Text="{loc:TrFormat Path=DisplaySource, Key=EewPanel.F09}" FontSize="12" Margin="5,0" />
		</Border>
        <Panel Grid.Row="1" Grid.RowSpan="2" Classes="container" IsVisible="{Binding IsCancelled}" VerticalAlignment="Stretch">
            <TextBlock IsVisible="{Binding !IsTrueCancelled}" Text="{loc:Tr EewPanel.18}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <TextBlock IsVisible="{Binding IsTrueCancelled}" Text="{loc:Tr EewPanel.19}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Panel>
    </Grid>
</UserControl>
