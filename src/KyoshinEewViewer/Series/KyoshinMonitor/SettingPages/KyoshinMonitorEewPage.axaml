<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:control="clr-namespace:KyoshinEewViewer.Controls;assembly=KyoshinEewViewer"
			 xmlns:vm="using:KyoshinEewViewer.ViewModels"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="1200"
			 x:DataType="vm:SettingWindowViewModel" x:CompileBindings="True" xmlns:loc="using:KyoshinEewViewer.Localization"
             x:Class="KyoshinEewViewer.Series.KyoshinMonitor.SettingPages.KyoshinMonitorEewPage">
    <UserControl.Styles>
        <Style Selector="Label">
            <Setter Property="Foreground" Value="{DynamicResource MainForegroundColor}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="ui|FASettingsExpander">
            <Setter Property="Margin" Value="10,3,10,0" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel>
            <Expander Margin="10,5">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xf05a;" Classes="icon" Margin="0,0,0,-5" />
                        <TextBlock Text="{loc:Tr KyoshinMonitorEewPage.01}" />
                    </StackPanel>
                </Expander.Header>
                <control:MarkdownViewer HorizontalAlignment="Stretch" Source="avares://KyoshinEewViewer/Assets/EewAbout.md" Margin="-10" />
            </Expander>

            <TextBlock Text="{loc:Tr KyoshinMonitorEewPage.02}" FontWeight="Bold" Margin="10,20,10,5" />
            <ui:FASettingsExpander Header="{loc:Tr KyoshinMonitorEewPage.03}">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf0f3;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Config.Eew.SwitchAtAnnounce}" OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>
            <ui:FASettingsExpander Header="{loc:Tr KyoshinMonitorEewPage.04}"
                                 Description="{loc:Tr KyoshinMonitorEewPage.05}">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf390;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Config.Eew.EnableKyoshinMonitor}" OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <TextBlock Text="{loc:Tr KyoshinMonitorEewPage.06}" FontWeight="Bold" Margin="10,20,10,5" />
            <ui:FASettingsExpander Header="{loc:Tr KyoshinMonitorEewPage.07}" Description="{loc:Tr KyoshinMonitorEewPage.08}" IsExpanded="True">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf550;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Config.Eew.ShowDetails}" OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" />
                </ui:FASettingsExpander.Footer>
                <TextBlock Text="{loc:Tr KyoshinMonitorEewPage.09}" FontSize="12" Margin="5,-9,0,0" />
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="{loc:Tr KyoshinMonitorEewPage.10}" Description="{loc:Tr KyoshinMonitorEewPage.11}">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf83e;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Config.Eew.SyncKyoshinMonitorPsWave}" OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" />
                </ui:FASettingsExpander.Footer>
                <TextBlock Text="{loc:Tr KyoshinMonitorEewPage.12}" FontSize="12" Margin="5,-9,0,0" />
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="{loc:Tr KyoshinMonitorEewPage.13}" Description="{loc:Tr KyoshinMonitorEewPage.14}" IsExpanded="True">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf363;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Config.Eew.DisableAnimation}" OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="{loc:Tr KyoshinMonitorEewPage.15}" IsExpanded="True">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf576;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>

                <ui:FASettingsExpanderItem Content="{loc:Tr KyoshinMonitorEewPage.16}" Description="{loc:Tr KyoshinMonitorEewPage.17}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.Eew.FillWarningArea}" OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <ui:FASettingsExpanderItem Content="{loc:Tr KyoshinMonitorEewPage.18}" Description="{loc:Tr KyoshinMonitorEewPage.19}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.Eew.FillForecastIntensity}" OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <!-- 地点予測の取り込みが有効な場合のみ表示する -->
            <ui:FASettingsExpander Header="{loc:Tr KyoshinMonitorEewPage.20}" Description="{loc:Tr KyoshinMonitorEewPage.21}" IsExpanded="True"
                                   IsVisible="{Binding Config.Eew.EnableWebhookPointForecast}">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf3c5;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>

                <ui:FASettingsExpanderItem Content="{loc:Tr KyoshinMonitorEewPage.22}" Description="{loc:Tr KyoshinMonitorEewPage.23}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.Eew.ShowPointForecastOnMap}" OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <ui:FASettingsExpanderItem Content="{loc:Tr KyoshinMonitorEewPage.24}" Description="{loc:Tr KyoshinMonitorEewPage.25}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.Eew.ExpandPointForecast}" OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <ui:FASettingsExpanderItem Content="{loc:Tr KyoshinMonitorEewPage.26}" IsEnabled="{Binding Config.Eew.ExpandPointForecast}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox ItemsSource="{x:Static vm:SettingWindowViewModel.PointForecastExpandIntensityNames}" SelectedValue="{Binding Config.Eew.PointForecastExpandIntensity}" SelectedValueBinding="{ReflectionBinding Key}" DisplayMemberBinding="{ReflectionBinding Value}"
                                  MinWidth="160" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <TextBlock Text="{loc:Tr KyoshinMonitorEewPage.27}" FontWeight="Bold" Margin="10,20,10,5" />

            <ui:FASettingsExpander Description="{loc:Tr KyoshinMonitorEewPage.28}" IsExpanded="True">
                <ui:FASettingsExpander.Header>
                    <StackPanel Orientation="Horizontal">
                        <control:HyperlinkTextBlock Text="SignalNow Professional" Uri="https://www.kobayashiyoko-com.jp/sn/" />
                        <TextBlock Text="{loc:Tr KyoshinMonitorEewPage.29}" FontSize="12" />
                    </StackPanel>
                </ui:FASettingsExpander.Header>
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf52e;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>

                <ui:FASettingsExpanderItem Content="{loc:Tr KyoshinMonitorEewPage.30}" Description="{loc:Tr KyoshinMonitorEewPage.31}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.Eew.EnableSignalNowProfessional}" OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{loc:Tr KyoshinMonitorEewPage.32}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.Eew.EnableSignalNowProfessionalLocation}" OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{loc:Tr KyoshinMonitorEewPage.33}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsEnabled="False" OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <ui:FASettingsExpanderItem Content="{loc:Tr KyoshinMonitorEewPage.34}" Description="{loc:Tr KyoshinMonitorEewPage.35}" />
                <ui:FASettingsExpanderItem>
                    <TextBlock Text="{loc:Tr KyoshinMonitorEewPage.36}"
                       Background="{DynamicResource WarningBackgroundColor}"
                       Foreground="{DynamicResource WarningForegroundColor}"
                       FontWeight="Bold" FontSize="12" />
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <Expander Header="DM-D.S.S" IsExpanded="True" Margin="10,3">
                <StackPanel>
                    <TextBlock Text="{loc:Tr KyoshinMonitorEewPage.37}" FontSize="12" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
