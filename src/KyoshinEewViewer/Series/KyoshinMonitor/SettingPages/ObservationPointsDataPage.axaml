<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:KyoshinEewViewer.Series.KyoshinMonitor.SettingPages"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="600"
			 x:DataType="vm:ObservationPointsDataPageViewModel" xmlns:loc="using:KyoshinEewViewer.Localization"
             x:Class="KyoshinEewViewer.Series.KyoshinMonitor.SettingPages.ObservationPointsDataPage">
	<UserControl.Styles>
		<Style Selector="Label">
			<Setter Property="Foreground" Value="{DynamicResource MainForegroundColor}" />
		</Style>
		<Style Selector="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="ui|FASettingsExpander">
			<Setter Property="Margin" Value="10,3,10,0" />
		</Style>
	</UserControl.Styles>
	<ScrollViewer>
		<StackPanel>
			<ui:FASettingsExpander Header="{loc:Tr ObservationPointsDataPage.01}" Description="{loc:Tr ObservationPointsDataPage.02}">
				<ui:FASettingsExpander.IconSource>
					<ui:FAFontIconSource Glyph="&#xf021;" FontFamily="{StaticResource IconFont}" />
				</ui:FASettingsExpander.IconSource>
				<ui:FASettingsExpander.Footer>
					<ToggleSwitch IsChecked="{Binding Config.KyoshinMonitor.AutoUpdateObservationPoints}" OnContent="{loc:Tr Common.Enabled}" OffContent="{loc:Tr Common.Disabled}" />
				</ui:FASettingsExpander.Footer>
			</ui:FASettingsExpander>

			<TextBlock Text="{loc:Tr ObservationPointsDataPage.03}" FontWeight="Bold" Margin="10,20,10,5" />
			<ui:FASettingsExpander Header="{loc:Tr ObservationPointsDataPage.04}" Description="{loc:Tr ObservationPointsDataPage.05}">
				<ui:FASettingsExpander.IconSource>
					<ui:FAFontIconSource Glyph="&#xf05a;" FontFamily="{StaticResource IconFont}" />
				</ui:FASettingsExpander.IconSource>
				<ui:FASettingsExpander.Footer>
					<TextBlock Text="{Binding DataVersion}" FontWeight="SemiBold" />
				</ui:FASettingsExpander.Footer>
			</ui:FASettingsExpander>

			<ui:FASettingsExpander Header="{loc:Tr ObservationPointsDataPage.06}" Footer="{Binding PackedAt}">
				<ui:FASettingsExpander.IconSource>
					<ui:FAFontIconSource Glyph="&#xf073;" FontFamily="{StaticResource IconFont}" />
				</ui:FASettingsExpander.IconSource>
			</ui:FASettingsExpander>

			<ui:FASettingsExpander Header="{loc:Tr ObservationPointsDataPage.07}">
				<ui:FASettingsExpander.IconSource>
					<ui:FAFontIconSource Glyph="&#xf1c0;" FontFamily="{StaticResource IconFont}" />
				</ui:FASettingsExpander.IconSource>
				<ui:FASettingsExpander.Footer>
					<TextBlock Text="{Binding Source}" FontSize="12" />
				</ui:FASettingsExpander.Footer>
			</ui:FASettingsExpander>

			<ui:FASettingsExpander Header="{loc:Tr ObservationPointsDataPage.08}" Footer="{loc:TrFormat Path=ObservationPointsCount, Key=ObservationPointsDataPage.F01}">
				<ui:FASettingsExpander.IconSource>
					<ui:FAFontIconSource Glyph="&#xf279;" FontFamily="{StaticResource IconFont}" />
				</ui:FASettingsExpander.IconSource>
			</ui:FASettingsExpander>

			<TextBlock Text="{loc:Tr ObservationPointsDataPage.09}" FontWeight="Bold" Margin="10,20,10,5" />
			<ui:FASettingsExpander Header="{loc:Tr ObservationPointsDataPage.10}" Description="{loc:Tr ObservationPointsDataPage.11}">
				<ui:FASettingsExpander.IconSource>
					<ui:FAFontIconSource Glyph="&#xf2f1;" FontFamily="{StaticResource IconFont}" />
				</ui:FASettingsExpander.IconSource>
				<ui:FASettingsExpander.Footer>
					<Button Content="{loc:Tr ObservationPointsDataPage.09}" Command="{Binding ManualUpdateCommand}" IsEnabled="{Binding !IsUpdating}" />
				</ui:FASettingsExpander.Footer>

				<StackPanel Spacing="5" Margin="0,5">
					<TextBlock Text="{Binding UpdateStatus}" FontSize="12" Foreground="{DynamicResource SystemAccentColor}" />
					<TextBlock Text="{loc:Tr ObservationPointsDataPage.12}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
				</StackPanel>
			</ui:FASettingsExpander>
		</StackPanel>
	</ScrollViewer>
</UserControl>
