<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:KyoshinEewViewer.Series.KyoshinMonitor.SettingPages"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="1500"
			 x:DataType="vm:KyoshinMonitorReplaySettingPage" xmlns:loc="using:KyoshinEewViewer.Localization"
             x:Class="KyoshinEewViewer.Series.KyoshinMonitor.SettingPages.KyoshinMonitorReplayPage">
    <UserControl.Styles>
        <Style Selector="Label">
            <Setter Property="Foreground" Value="{DynamicResource MainForegroundColor}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="ui|FASettingsExpander">
            <Setter Property="Margin" Value="10,3,10,0" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel>
            <Border
                Background="{DynamicResource ExpanderHeaderBackground}"
                MinHeight="72"
                Padding="{DynamicResource SettingsExpanderItemPadding}"
                BorderThickness="1" BorderBrush="#19000000"
                CornerRadius="4" Margin="10,3,10,0">
                <Grid ColumnDefinitions="45,*,auto" VerticalAlignment="Center">
                    <ui:FAFontIcon Glyph="&#xf201;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Left" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{loc:Tr KyoshinMonitorReplayPage.01}" />
                        <TextBlock Text="{Binding Series.CurrentInformationHost.ReplayDescription}" Foreground="{DynamicResource SubForegroundColor}" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="accent" Content="{loc:Tr KyoshinMonitorReplayPage.02}" HorizontalAlignment="Center"
                            IsVisible="{Binding Series.NowReplaying}" Command="{Binding Series.ReturnToRealtime}" />
                </Grid>
            </Border>
            <ui:FASettingsExpander Header="{loc:Tr KyoshinMonitorReplayPage.03}"
                                 Description="{loc:Tr KyoshinMonitorReplayPage.04}">
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" IsChecked="{Binding Config.KyoshinMonitor.KeepReceiveDuringReplay}" />
                </ui:FASettingsExpander.Footer>
                <ui:FASettingsExpanderItem Content="{loc:Tr KyoshinMonitorReplayPage.05}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" IsChecked="{Binding Config.KyoshinMonitor.ReturnToRealtimeAtShakeDetected}"  />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>
            <ui:FASettingsExpander Header="{loc:Tr KyoshinMonitorReplayPage.06}"
                                 Description="{loc:Tr KyoshinMonitorReplayPage.07}">
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" IsChecked="{Binding Config.KyoshinMonitor.ReturnToRealtimeAtEewReceived}" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>
            <TextBlock Text="{loc:Tr KyoshinMonitorReplayPage.08}" FontWeight="Bold" Margin="10,20,10,5" />
            <Expander IsExpanded="True" Margin="10,3,10,0">
                <Expander.Header>
                    <Grid ColumnDefinitions="40,*" RowDefinitions="*,auto" Margin="0,15">
                        <ui:FAFontIcon Glyph="&#xf1da;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Left" Grid.RowSpan="2" />
                        <TextBlock Grid.Column="1" Grid.Row="0" Text="{loc:Tr KyoshinMonitorReplayPage.09}" FontSize="14" />
                        <TextBlock Grid.Column="1" Grid.Row="1" Text="{loc:Tr KyoshinMonitorReplayPage.10}" FontSize="12" Foreground="{DynamicResource SubForegroundColor}" />
                    </Grid>
                </Expander.Header>
                <StackPanel HorizontalAlignment="Stretch">
                    <Panel Margin="0,5,0,-5">
                        <TextBlock Text="{loc:Tr KyoshinMonitorReplayPage.11}" FontSize="14" HorizontalAlignment="Left" />
                        <TextBlock Text="{loc:Tr KyoshinMonitorReplayPage.12}" FontSize="14" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding TimeshiftSecondsString}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TimeshiftedDateTime, StringFormat={}yyyy/MM/dd HH:mm:ss}" HorizontalAlignment="Center" Margin="0,-28,0,0" Foreground="{DynamicResource SubForegroundColor}" FontSize="14" />
                    </Panel>
                    <Slider Margin="0,5" Value="{Binding TimeshiftSeconds}"
                            Minimum="0" Maximum="10800" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-15,0,0">
                        <StackPanel.Styles>
                            <Style Selector="Button">
                                <Setter Property="Width" Value="60" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="Command" Value="{Binding OffsetTimeshiftSeconds}" />
                            </Style>
                        </StackPanel.Styles>
                        <Button Content="+10m" CommandParameter="-600" />
                        <Button Content="+1m" CommandParameter="-60" />
                        <Button Content="+30s" CommandParameter="-30" />
                        <Button Content="+10s" CommandParameter="-10" />
                        <Button Content="-10s" CommandParameter="10" />
                        <Button Content="-30s" CommandParameter="30" />
                        <Button Content="-1m" CommandParameter="60" />
                        <Button Content="-10m" CommandParameter="600" />
                    </StackPanel>
                    <Button Content="{loc:Tr KyoshinMonitorReplayPage.13}" Command="{Binding Series.StartTimeshift}"
                            HorizontalAlignment="Center" Margin="0,5" />
                    <TextBlock Text="{loc:Tr KyoshinMonitorReplayPage.14}" FontSize="12" />
                </StackPanel>
            </Expander>
            
            <Expander IsExpanded="True" Margin="10,3,10,0" IsVisible="{Binding IsDebug}">
                <Expander.Header>
                    <Grid ColumnDefinitions="40,*" RowDefinitions="*,auto" Margin="0,15">
                        <ui:FAFontIcon Glyph="&#xf15b;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Left" Grid.RowSpan="2" />
                        <TextBlock Grid.Column="1" Grid.Row="0" Text="{loc:Tr KyoshinMonitorReplayPage.15}" FontSize="14" />
                        <TextBlock Grid.Column="1" Grid.Row="1" Text="{loc:Tr KyoshinMonitorReplayPage.16}" FontSize="12" Foreground="{DynamicResource SubForegroundColor}" />
                    </Grid>
                </Expander.Header>
                <StackPanel HorizontalAlignment="Stretch" Spacing="5">
                    <Button Content="{loc:Tr KyoshinMonitorReplayPage.17}" HorizontalAlignment="Center" Command="{Binding OpenReplayFile}" />
                    <TextBlock Text="{loc:Tr KyoshinMonitorReplayPage.18}" FontWeight="Bold" Margin="10,20,10,5" />
                    <Grid ColumnDefinitions="auto,*" RowDefinitions="auto,auto,auto,auto,auto">
                        <TextBlock Text="{loc:Tr KyoshinMonitorReplayPage.19}" />
                        <TextBlock Text="{Binding Series.ReplayFileInformationHost.LoadedHeader.Version}" Grid.Column="1" />
                        <TextBlock Text="{loc:Tr KyoshinMonitorReplayPage.20}" Grid.Row="1" />
                        <TextBlock Text="{Binding Series.ReplayFileInformationHost.LoadedHeader.SoftwareName}" Grid.Row="1" Grid.Column="1" />
                        <TextBlock Text="{loc:Tr KyoshinMonitorReplayPage.21}" Grid.Row="2" />
                        <TextBlock Text="{Binding Series.ReplayFileInformationHost.LoadedHeader.StartTime, StringFormat=yyyy/MM/dd HH:mm:ss.fff}" Grid.Row="2" Grid.Column="1" />
                        <TextBlock Text="{loc:Tr KyoshinMonitorReplayPage.22}" Grid.Row="3" />
                        <TextBlock Text="{Binding Series.ReplayFileInformationHost.LoadedHeader.EndTime, StringFormat=yyyy/MM/dd HH:mm:ss.fff}" Grid.Row="3" Grid.Column="1" />
                        <TextBlock Text="{loc:Tr KyoshinMonitorReplayPage.23}" Grid.Row="4" />
                        <TextBlock Text="{Binding Series.ReplayFileInformationHost.LoadedHeader.CompressionMode}" Grid.Row="4" Grid.Column="1" />
                    </Grid>
                    
                    <TextBlock Text="{loc:Tr KyoshinMonitorReplayPage.24}" FontWeight="Bold" Margin="10,20,10,5" />
                    <TextBlock Text="{loc:TrFormat Path=Series.ReplayFileInformationHost.SpeedMultiplier, Key=KyoshinMonitorReplayPage.F01}" />
                    <TextBlock Text="{loc:Tr KyoshinMonitorReplayPage.25}" FontSize="12" Foreground="{DynamicResource SubForegroundColor}" />
                    <Slider Value="{Binding Series.ReplayFileInformationHost.SpeedMultiplier}" Minimum="0.1" Maximum="30" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                        <Button Content="{loc:Tr KyoshinMonitorReplayPage.26}" HorizontalAlignment="Center" IsEnabled="{Binding Series.ReplayFileInformationHost.LoadedData, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Command="{Binding Series.StartReplayFile}" />
                        <Button Content="{loc:Tr KyoshinMonitorReplayPage.27}" Command="{Binding Series.ReplayFileInformationHost.ResetSpeedMultiplier}" />
                    </StackPanel>
                    
                    <TextBlock Text="{loc:Tr KyoshinMonitorReplayPage.28}" FontWeight="Bold" Margin="10,20,10,5" />
                    <Grid ColumnDefinitions="auto,*" RowDefinitions="auto,auto,auto,auto,auto">
                        <TextBlock Text="{loc:Tr KyoshinMonitorReplayPage.19}" />
                        <TextBlock Text="{Binding Series.ReplayFileInformationHost.CurrentHeader.Version}" Grid.Column="1" />
                        <TextBlock Text="{loc:Tr KyoshinMonitorReplayPage.20}" Grid.Row="1" />
                        <TextBlock Text="{Binding Series.ReplayFileInformationHost.CurrentHeader.SoftwareName}" Grid.Row="1" Grid.Column="1" />
                        <TextBlock Text="{loc:Tr KyoshinMonitorReplayPage.21}" Grid.Row="2" />
                        <TextBlock Text="{Binding Series.ReplayFileInformationHost.CurrentHeader.StartTime, StringFormat=yyyy/MM/dd HH:mm:ss.fff}" Grid.Row="2" Grid.Column="1" />
                        <TextBlock Text="{loc:Tr KyoshinMonitorReplayPage.22}" Grid.Row="3" />
                        <TextBlock Text="{Binding Series.ReplayFileInformationHost.CurrentHeader.EndTime, StringFormat=yyyy/MM/dd HH:mm:ss.fff}" Grid.Row="3" Grid.Column="1" />
                        <TextBlock Text="{loc:Tr KyoshinMonitorReplayPage.23}" Grid.Row="4" />
                        <TextBlock Text="{Binding Series.ReplayFileInformationHost.CurrentHeader.CompressionMode}" Grid.Row="4" Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
