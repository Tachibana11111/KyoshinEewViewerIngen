<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		     xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:wf="clr-namespace:KyoshinEewViewer.Series.KyoshinMonitor.Workflow;assembly=KyoshinEewViewer"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="wf:EewTrigger" x:CompileBindings="True" xmlns:loc="using:KyoshinEewViewer.Localization"
             x:Class="KyoshinEewViewer.Series.KyoshinMonitor.Workflow.EewTriggerControl">
    <StackPanel>
        <TextBlock Text="{loc:Tr EewTrigger.01}" FontWeight="Bold" />
        <TextBlock Text="{loc:Tr EewTrigger.02}" FontSize="12" Foreground="{DynamicResource SubForegroundColor}" />
        <StackPanel Orientation="Horizontal" Margin="5,5,0,0">
            <TextBlock Text="{loc:Tr EewTrigger.03}" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{x:Static wf:EewTrigger.ShindoNames}" SelectedValue="{Binding Intensity}" SelectedValueBinding="{ReflectionBinding Key}" DisplayMemberBinding="{ReflectionBinding Value}" />
            <CheckBox Content="{loc:Tr EewTrigger.04}" IsChecked="{Binding IncludeGreaterIntensity}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="5,5,0,0"
                    ToolTip.Tip="{loc:Tr EewTrigger.05}">
            <TextBlock Text="{loc:Tr EewTrigger.06}" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding Magnitude}" Minimum="0" Maximum="9.9" Increment="0.1" FormatString="0.0" Width="140" />
            <TextBlock Text="{loc:Tr EewPanel.07}" VerticalAlignment="Center" Margin="4,0,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="5,5,0,5">
            <RadioButton Content="{loc:Tr EewTrigger.07}" IsChecked="{Binding UseAndCondition}" />
            <RadioButton Content="{loc:Tr EewTrigger.08}" IsChecked="{Binding !UseAndCondition}" Margin="10,0,0,0" />
        </StackPanel>
        <TextBlock Text="{loc:Tr EewTrigger.09}" FontWeight="Bold" />
        <TextBlock Text="{loc:Tr EewTrigger.10}" FontSize="12" Foreground="{DynamicResource SubForegroundColor}" />
        <WrapPanel Margin="5,0">
            <CheckBox Content="{loc:Tr EewTrigger.11}" IsChecked="{Binding New}" />
            <CheckBox Content="{loc:Tr EewTrigger.12}" IsChecked="{Binding Continue}" />
            <CheckBox Content="{loc:Tr EewTrigger.13}" IsChecked="{Binding UpdateWithMoreAccurate}"
                      ToolTip.Tip="{loc:Tr EewTrigger.14}" />
            <CheckBox Content="{loc:Tr EewTrigger.15}" IsChecked="{Binding Final}" />
            <CheckBox Content="{loc:Tr EewTrigger.16}" IsChecked="{Binding Cancel}" />
        </WrapPanel>
        <WrapPanel Margin="5,0">
            <CheckBox Content="{loc:Tr EewTrigger.17}" IsChecked="{Binding NewWarning}"
                      ToolTip.Tip="{loc:Tr EewTrigger.18}" />
            <CheckBox Content="{loc:Tr EewTrigger.19}" IsChecked="{Binding ContinueWarning}"
                      ToolTip.Tip="{loc:Tr EewTrigger.18}" />
            <CheckBox Content="{loc:Tr EewTrigger.20}" IsChecked="{Binding CancelWarning}"
                      ToolTip.Tip="{loc:Tr EewTrigger.18}" />
        </WrapPanel>
        <TextBlock Text="{loc:Tr EewTrigger.21}" FontWeight="Bold" />
        <TextBlock Text="{loc:Tr EewTrigger.22}" FontSize="12" Foreground="{DynamicResource SubForegroundColor}" />
        <WrapPanel Margin="5,0">
            <CheckBox Content="{loc:Tr EewTrigger.23}" IsChecked="{Binding WarningLevelReached}"
                      ToolTip.Tip="{loc:Tr EewTrigger.24}" />
            <CheckBox Content="{loc:Tr EewTrigger.25}" IsChecked="{Binding IncreaseInIntensity}"
                      ToolTip.Tip="{loc:Tr EewTrigger.26}" />
            <CheckBox Content="{loc:Tr EewTrigger.27}" IsChecked="{Binding DecreaseInIntensity}"
                      ToolTip.Tip="{loc:Tr EewTrigger.28}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
