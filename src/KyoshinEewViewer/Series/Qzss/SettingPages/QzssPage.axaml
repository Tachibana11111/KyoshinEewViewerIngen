<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:control="clr-namespace:KyoshinEewViewer.Controls;assembly=KyoshinEewViewer"
			 xmlns:vm="using:KyoshinEewViewer.Series.Qzss.SettingPages"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="1600"
			 x:DataType="vm:QzssSettingPage" x:CompileBindings="True" xmlns:loc="using:KyoshinEewViewer.Localization"
             x:Class="KyoshinEewViewer.Series.Qzss.SettingPages.QzssPage">
    <UserControl.Styles>
        <Style Selector="Label">
            <Setter Property="Foreground" Value="{DynamicResource MainForegroundColor}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="ui|FASettingsExpander">
            <Setter Property="Margin" Value="10,3,10,0" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel>
            <Expander Header="{loc:Tr QzssPage.01}" IsExpanded="True" Margin="5">
                <control:MarkdownViewer HorizontalAlignment="Stretch" Source="avares://KyoshinEewViewer/Assets/QzssAbout.md" />
            </Expander>

            <TextBlock Text="{loc:Tr QzssPage.02}" FontWeight="Bold" Margin="10,20,10,5" />
            <ui:FASettingsExpander Header="{loc:Tr QzssPage.03}" IsExpanded="True">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf1e6;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Content="{loc:Tr QzssPage.04}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox IsEnabled="{Binding CanEditConnection}"
                                  ItemsSource="{x:Static vm:QzssSettingPage.ConnectionTypeNames}"
                                  SelectedValue="{Binding Config.Qzss.ConnectionType}"
                                  SelectedValueBinding="{ReflectionBinding Key}" DisplayMemberBinding="{ReflectionBinding Value}"
                                  HorizontalAlignment="Right" MinWidth="200" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{loc:Tr QzssPage.05}" Description="{loc:Tr QzssPage.06}" IsVisible="{Binding IsTcpConnection}">
                    <ui:FASettingsExpanderItem.Footer>
                        <TextBox IsEnabled="{Binding CanEditConnection}" Text="{Binding Config.Qzss.TcpHost}" HorizontalAlignment="Right" MinWidth="200" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{loc:Tr QzssPage.07}" IsVisible="{Binding IsTcpConnection}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ui:FANumberBox IsEnabled="{Binding CanEditConnection}" Value="{Binding Config.Qzss.TcpPort}" Minimum="1" Maximum="65535" HorizontalAlignment="Right" MinWidth="100" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{loc:Tr QzssPage.08}" IsVisible="{Binding IsSerialConnection}">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox IsEnabled="{Binding CanEditConnection}"
                                      SelectedItem="{Binding Config.Qzss.SerialPort}"
                                      ItemsSource="{Binding SerialPorts}"
                                      HorizontalAlignment="Right" MinWidth="200" IsTextSearchEnabled="True" />
                            <Button IsEnabled="{Binding CanEditConnection}" Content="{loc:Tr ObservationPointsDataPage.09}" Command="{Binding UpdateSerialPorts}" Margin="5,0,0,0" />
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{loc:Tr QzssPage.09}" IsVisible="{Binding IsSerialConnection}">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ComboBox IsEnabled="{Binding CanEditConnection}"
                                      SelectedItem="{Binding Config.Qzss.BaudRate}"
                                      ItemsSource="{Binding SerialBaudRates}"
                                      HorizontalAlignment="Right" MinWidth="100" />
                            <Button Content="{Binding DetectBaudRateButtonLabel}"
                                    Command="{Binding DetectOrCancelBaudRate}"
                                    IsEnabled="{Binding !Config.Qzss.Connect}"
                                    ToolTip.Tip="{loc:Tr QzssPage.10}" />
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem.Footer>
                        <CheckBox IsChecked="{Binding Config.Qzss.Connect}" IsEnabled="{Binding !IsDetectingBaudRate}" Content="{loc:Tr QzssPage.11}" HorizontalAlignment="Center" Padding="15,7" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="{loc:Tr QzssPage.12}" Description="{loc:Tr QzssPage.13}" IsVisible="{Binding IsSerialConnection}">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf013;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Content="{loc:Tr QzssPage.14}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.Qzss.SetupSendSfrbx}" IsEnabled="{Binding !IsSettingUp}" OnContent="{loc:Tr QzssPage.15}" OffContent="{loc:Tr QzssPage.16}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{loc:Tr QzssPage.17}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.Qzss.SetupSendRmc}" IsEnabled="{Binding !IsSettingUp}" OnContent="{loc:Tr QzssPage.15}" OffContent="{loc:Tr QzssPage.16}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{loc:Tr QzssPage.18}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.Qzss.SetupEnableQzss}" IsEnabled="{Binding !IsSettingUp}" OnContent="{loc:Tr QzssPage.15}" OffContent="{loc:Tr QzssPage.16}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{loc:Tr QzssPage.19}">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ComboBox SelectedItem="{Binding Config.Qzss.SetupUpdateRateMs}"
                                      ItemsSource="{Binding SetupUpdateRates}"
                                      IsEnabled="{Binding Config.Qzss.SetupChangeUpdateRate}"
                                      MinWidth="100">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={}{0} ms}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ToggleSwitch IsChecked="{Binding Config.Qzss.SetupChangeUpdateRate}" IsEnabled="{Binding !IsSettingUp}" OnContent="{loc:Tr QzssPage.15}" OffContent="{loc:Tr QzssPage.16}" />
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{loc:Tr QzssPage.20}" Description="{loc:Tr QzssPage.21}">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ComboBox SelectedItem="{Binding Config.Qzss.SetupBaudRate}"
                                      ItemsSource="{Binding SetupBaudRates}"
                                      IsEnabled="{Binding Config.Qzss.SetupChangeBaudRate}"
                                      MinWidth="100" />
                            <ToggleSwitch IsChecked="{Binding Config.Qzss.SetupChangeBaudRate}" IsEnabled="{Binding !IsSettingUp}" OnContent="{loc:Tr QzssPage.15}" OffContent="{loc:Tr QzssPage.16}" />
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Description="{loc:Tr QzssPage.22}">
                    <ui:FASettingsExpanderItem.Footer>
                        <Button Content="{loc:Tr QzssPage.23}" Command="{Binding SetupForUBlox}" IsEnabled="{Binding CanRunSetup}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem IsVisible="{Binding HasSetupSteps}">
                    <ItemsControl ItemsSource="{Binding SetupSteps}" Margin="0,5">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SetupStep">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Width="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Classes.pending="{Binding IsPending}"
                                               Classes.running="{Binding IsRunning}"
                                               Classes.success="{Binding IsSuccess}"
                                               Classes.failed="{Binding IsFailed}"
                                               Classes.skipped="{Binding IsSkipped}">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock.pending">
                                                <Setter Property="Text" Value="…" />
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Style>
                                            <Style Selector="TextBlock.running">
                                                <Setter Property="Text" Value="&gt;" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </Style>
                                            <Style Selector="TextBlock.success">
                                                <Setter Property="Text" Value="&#xf00c;" />
                                                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                                                <Setter Property="Foreground" Value="LimeGreen" />
                                            </Style>
                                            <Style Selector="TextBlock.failed">
                                                <Setter Property="Text" Value="&#xf00d;" />
                                                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                                                <Setter Property="Foreground" Value="OrangeRed" />
                                            </Style>
                                            <Style Selector="TextBlock.skipped">
                                                <Setter Property="Text" Value="—" />
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Style>
                                        </TextBlock.Styles>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" VerticalAlignment="Center" Foreground="OrangeRed" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <TextBlock Text="{loc:Tr KyoshinMonitorEewPage.06}" FontWeight="Bold" Margin="10,20,10,5" />

            <ui:FASettingsExpander Header="{loc:Tr QzssPage.24}" Description="{loc:Tr QzssPage.25}">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf3c5;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Config.Qzss.HidePositionNumber}" OnContent="{loc:Tr QzssPage.26}" OffContent="{loc:Tr QzssPage.27}" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>
            <ui:FASettingsExpander Header="{loc:Tr QzssPage.28}">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf3c5;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Config.Qzss.ShowCurrentPositionInMap}" OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>
            <ui:FASettingsExpander Header="{loc:Tr QzssPage.29}">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf3c5;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Config.Qzss.IgnoreOtherOrganizationReport}" OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>
            <ui:FASettingsExpander Header="{loc:Tr QzssPage.30}">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf3c5;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Config.Qzss.IgnoreTrainingOrTestReport}" OnContent="{loc:Tr Common.On}" OffContent="{loc:Tr Common.Off}" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>
            <ui:FASettingsExpander Header="{loc:Tr QzssPage.31}" Description="{loc:Tr QzssPage.32}">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource Glyph="&#xf017;" FontFamily="{StaticResource IconFont}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <ui:FANumberBox Value="{Binding Config.Qzss.TimezoneOffset}" Minimum="-12" Maximum="14" SpinButtonPlacementMode="Inline" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <HeaderedContentControl IsVisible="False">
                <HeaderedContentControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xf7c0;" Classes="icon" />
                        <TextBlock Text="{loc:Tr QzssPage.33}" />
                    </StackPanel>
                </HeaderedContentControl.Header>
                <StackPanel>
                    <CheckBox Content="{loc:Tr Setting.Eew}" />
                    <TextBlock Text="{loc:Tr QzssPage.34}" FontSize="12" Margin="0,-9,0,0" />
                    <CheckBox Content="{loc:Tr Series.Tsunami}" />
                    <TextBlock Text="{loc:Tr QzssPage.35}" FontSize="12" Margin="0,-9,0,0" />
                    <TextBlock Text="{loc:Tr QzssPage.36}" Margin="0,20" />
                    <CheckBox Content="{loc:Tr QzssPage.37}" />
                    <TextBlock Text="{loc:Tr QzssPage.38}" FontSize="12" Margin="0,-9,0,0" />
                    <CheckBox Content="{loc:Tr QzssPage.39}" />
                    <CheckBox Content="{loc:Tr QzssPage.40}" />
                    <CheckBox Content="{loc:Tr QzssPage.41}" IsEnabled="False" />
                    <CheckBox Content="{loc:Tr QzssPage.42}" IsEnabled="False" />
                    <CheckBox Content="{loc:Tr QzssPage.43}" IsEnabled="False" />
                    <CheckBox Content="{loc:Tr QzssPage.44}" IsEnabled="False" />
                    <CheckBox Content="{loc:Tr QzssPage.45}" IsEnabled="False" />
                    <CheckBox Content="{loc:Tr QzssPage.46}" IsEnabled="False" />
                </StackPanel>
            </HeaderedContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
