<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		     xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:wf="clr-namespace:KyoshinEewViewer.Series.Qzss.Workflow;assembly=KyoshinEewViewer"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="wf:QzssTrigger" x:CompileBindings="True" xmlns:loc="using:KyoshinEewViewer.Localization"
             x:Class="KyoshinEewViewer.QzssTriggerControl">
    <StackPanel>
        <TextBlock Text="{loc:Tr QzssTrigger.01}" FontWeight="Bold" />
        <TextBlock Text="{loc:Tr EewTrigger.10}" FontSize="12" Foreground="{DynamicResource SubForegroundColor}" />
        <WrapPanel Margin="5,0">
            <CheckBox Content="{loc:Tr QzssTrigger.02}" IsChecked="{Binding NewSentenceReceived}" ToolTip.Tip="{loc:Tr QzssTrigger.03}" />
            <CheckBox Content="{loc:Tr QzssTrigger.04}" IsChecked="{Binding ReportGroupCreated}" />
            <CheckBox Content="{loc:Tr QzssTrigger.05}" IsChecked="{Binding ReportGroupUpdated}" />
            <CheckBox Content="{loc:Tr QzssTrigger.06}" IsChecked="{Binding NankaiTroughReportCompleted}" ToolTip.Tip="{loc:Tr QzssTrigger.07}" />
        </WrapPanel>
        <TextBlock Text="{loc:Tr QzssTrigger.08}" FontWeight="Bold" />
        <TextBlock Text="{loc:Tr QzssTrigger.09}" FontSize="12" Foreground="{DynamicResource SubForegroundColor}" />
        <WrapPanel Margin="5,0">
            <CheckBox Content="{loc:Tr Setting.Eew}" IsChecked="{Binding Eew}" />
            <CheckBox Content="{loc:Tr EarthquakeView.22}" IsChecked="{Binding Hypocenter}" />
            <CheckBox Content="{loc:Tr EarthquakeView.14}" IsChecked="{Binding SeismicIntensity}" />
            <CheckBox Content="{loc:Tr QzssTrigger.10}" IsChecked="{Binding NankaiTrough}" />
            <CheckBox Content="{loc:Tr QzssTrigger.11}" IsChecked="{Binding Tsunami}" />
            <CheckBox Content="{loc:Tr QzssView.11}" IsChecked="{Binding NorthwestPacificTsunami}" />
            <CheckBox Content="{loc:Tr QzssTrigger.12}" IsChecked="{Binding Volcano}" />
            <CheckBox Content="{loc:Tr QzssTrigger.13}" IsChecked="{Binding AshFall}" />
            <CheckBox Content="{loc:Tr QzssTrigger.14}" IsChecked="{Binding Weather}" />
            <CheckBox Content="{loc:Tr QzssTrigger.15}" IsChecked="{Binding Flood}" />
            <CheckBox Content="{loc:Tr QzssTrigger.16}" IsChecked="{Binding Typhoon}" />
            <CheckBox Content="{loc:Tr QzssTrigger.17}" IsChecked="{Binding Marine}" />
            <CheckBox Content="{loc:Tr Common.Unknown}" IsChecked="{Binding Unknown}" />
            <CheckBox Content="DCX" IsChecked="{Binding DCX}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
