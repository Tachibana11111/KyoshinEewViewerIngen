<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		     xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:wf="clr-namespace:KyoshinEewViewer.Series.Tsunami.Workflow;assembly=KyoshinEewViewer"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="350"
             x:DataType="wf:TsunamiInformationTrigger" x:CompileBindings="True" xmlns:loc="using:KyoshinEewViewer.Localization"
             x:Class="KyoshinEewViewer.Series.Tsunami.Workflow.TsunamiInformationTriggerControl">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{loc:Tr TsunamiInformationTrigger.01}" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{x:Static wf:TsunamiInformationTrigger.LevelNames}" SelectedValue="{Binding Level}" SelectedValueBinding="{ReflectionBinding Key}" DisplayMemberBinding="{ReflectionBinding Value}" />
        </StackPanel>
        <CheckBox Content="{loc:Tr TsunamiInformationTrigger.02}" IsChecked="{Binding IsExact}"
                  ToolTip.Tip="{loc:Tr ShakeDetectTrigger.03}"/>

        <WrapPanel>
            <CheckBox IsChecked="{Binding EnableIssued}" Content="{loc:Tr TsunamiInformationTrigger.03}" Margin="0,2,10,2"
                      ToolTip.Tip="{loc:Tr TsunamiInformationTrigger.04}" />
            <CheckBox IsChecked="{Binding EnableUpgraded}" Content="{loc:Tr TsunamiInformationTrigger.05}" Margin="0,2,10,2"
                      ToolTip.Tip="{loc:Tr TsunamiInformationTrigger.06}" />
            <CheckBox IsChecked="{Binding EnableDowngraded}" Content="{loc:Tr TsunamiInformationTrigger.07}" Margin="0,2,10,2"
                      ToolTip.Tip="{loc:Tr TsunamiInformationTrigger.08}" />
            <CheckBox IsChecked="{Binding EnableUpdated}" Content="{loc:Tr TsunamiInformationTrigger.09}" Margin="0,2,10,2"
                      ToolTip.Tip="{loc:Tr TsunamiInformationTrigger.10}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
