<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		     xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:wf="clr-namespace:KyoshinEewViewer.Series.Earthquake.Workflow;assembly=KyoshinEewViewer"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="350"
             x:DataType="wf:EarthquakeInformationTrigger" x:CompileBindings="True" xmlns:loc="using:KyoshinEewViewer.Localization"
             x:Class="KyoshinEewViewer.Series.Earthquake.Workflow.EarthquakeInformationTriggerControl">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{loc:Tr EewTrigger.03}" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{x:Static wf:EarthquakeInformationTrigger.ShindoNames}" SelectedValue="{Binding Intensity}" SelectedValueBinding="{ReflectionBinding Key}" DisplayMemberBinding="{ReflectionBinding Value}" />
            <CheckBox Content="{loc:Tr EewTrigger.04}" IsChecked="{Binding IncludeGreaterIntensity}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <WrapPanel Margin="0,0,0,10">
            <RadioButton Content="{loc:Tr EarthquakeInformationTrigger.01}" IsChecked="{Binding !IsIntensityChangeOnly}"
                            ToolTip.Tip="{loc:Tr EarthquakeInformationTrigger.02}" />
            <RadioButton Content="{loc:Tr EarthquakeInformationTrigger.03}" IsChecked="{Binding IsIntensityChangeOnly}"
                            ToolTip.Tip="{loc:Tr EarthquakeInformationTrigger.04}" />
        </WrapPanel>
        <WrapPanel IsVisible="{Binding IsIntensityChangeOnly}">
            <CheckBox Content="{loc:Tr EarthquakeInformationTrigger.05}" IsChecked="{Binding IsIntensityIncreaseOnly}" />
        </WrapPanel>
        <WrapPanel IsVisible="{Binding !IsIntensityChangeOnly}">
            <CheckBox IsChecked="{Binding EnableSokuhou}" Content="{loc:Tr EarthquakePage.04}" />
            <CheckBox IsChecked="{Binding EnableEpicenter}" Content="{loc:Tr EarthquakeInformationTrigger.06}" />
            <CheckBox IsChecked="{Binding EnableDetail}" Content="{loc:Tr EarthquakePage.07}" />
            <CheckBox IsChecked="{Binding EnableUpdateEpicenter}" Content="{loc:Tr EarthquakeInformationTrigger.07}" />
            <CheckBox IsChecked="{Binding EnableTsunami}" Content="{loc:Tr EarthquakeInformationTrigger.08}" />
            <CheckBox IsChecked="{Binding EnableLpgm}" Content="{loc:Tr EarthquakeInformationTrigger.09}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
