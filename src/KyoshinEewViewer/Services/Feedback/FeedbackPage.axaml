<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KyoshinEewViewer.Services.Feedback"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
             x:DataType="vm:FeedbackSettingPage" x:CompileBindings="True" xmlns:loc="using:KyoshinEewViewer.Localization"
             x:Class="KyoshinEewViewer.Services.Feedback.FeedbackPage">
    <UserControl.Styles>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,10,0,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.fieldDescription">
            <Setter Property="Foreground" Value="{DynamicResource SubForegroundColor}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel>
            <TextBlock Text="{loc:Tr Setting.Feedback}" FontWeight="Bold" Margin="10,20,10,5" />

            <ui:FAInfoBar IsOpen="{Binding !IsAvailable}"
                        IsClosable="False"
                        Severity="Warning"
                        Title="{loc:Tr FeedbackPage.01}"
                        Message="{loc:Tr FeedbackPage.13}"
                        Margin="10,5" />

            <ui:FAInfoBar IsOpen="{Binding IsAvailable}"
                        IsClosable="False"
                        Severity="Informational"
                        Title="{loc:Tr FeedbackPage.02}"
                        Message="{loc:Tr FeedbackPage.14}"
                        Margin="10,5" />

            <StackPanel IsEnabled="{Binding IsAvailable}" Margin="15,5,15,15">
                <TextBlock Text="{loc:Tr FeedbackPage.03}" Classes="fieldLabel" />
                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedValue="{Binding Category}"
                          SelectedValueBinding="{ReflectionBinding Key}"
                          DisplayMemberBinding="{ReflectionBinding Value}"
                          HorizontalAlignment="Stretch" />

                <TextBlock Text="{loc:Tr FeedbackPage.04}" Classes="fieldLabel" />
                <TextBox Text="{Binding Subject}"
                         PlaceholderText="{loc:Tr FeedbackPage.15}"
                         MaxLength="200" />

                <TextBlock Text="{loc:Tr FeedbackPage.05}" Classes="fieldLabel" />
                <TextBox Text="{Binding Body}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="180"
                         MaxLength="10000"
                         PlaceholderText="{loc:Tr FeedbackPage.16}" />

                <TextBlock Text="{loc:Tr FeedbackPage.06}" Classes="fieldLabel" />
                <TextBlock Text="{loc:Tr FeedbackPage.07}" Classes="fieldDescription" />
                <TextBox Text="{Binding Email}"
                         PlaceholderText="example@example.com"
                         MaxLength="200" />

                <CheckBox IsChecked="{Binding IncludeLogs}"
                          Content="{loc:Tr FeedbackPage.08}"
                          Margin="0,15,0,0" />

                <Grid ColumnDefinitions="*,auto,auto" Margin="0,15,0,3">
                    <TextBlock Text="{loc:Tr FeedbackPage.09}" Classes="fieldLabel" Margin="0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding AttachmentsTotalSizeText}"
                               Foreground="{DynamicResource SubForegroundColor}"
                               VerticalAlignment="Center"
                               Margin="10,0" />
                    <Button Grid.Column="2"
                            Content="{loc:Tr FeedbackPage.10}"
                            Command="{Binding AddAttachmentCommand}" />
                </Grid>
                <TextBlock Text="{loc:Tr FeedbackPage.11}"
                           Classes="fieldDescription" />
                <ItemsControl ItemsSource="{Binding Attachments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FeedbackAttachment">
                            <Border BorderBrush="{DynamicResource SubForegroundColor}"
                                    BorderThickness="0,0,0,1"
                                    Padding="5,3">
                                <Grid ColumnDefinitions="*,auto,auto">
                                    <TextBlock Text="{Binding FileName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SizeText}"
                                               Foreground="{DynamicResource SubForegroundColor}"
                                               Margin="10,0"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Padding="8,4"
                                            Command="{Binding $parent[ItemsControl].((vm:FeedbackSettingPage)DataContext).RemoveAttachmentCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{loc:Tr FeedbackPage.12}">
                                        <ui:FASymbolIcon Symbol="Delete" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <TextBlock Text="{Binding ResultMessage}"
                               Foreground="{DynamicResource SubForegroundColor}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,10,0" />
                    <Button Content="{loc:Tr QzssPage.15}"
                            Classes="accent"
                            FontSize="16"
                            MinWidth="120"
                            Command="{Binding SendCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
