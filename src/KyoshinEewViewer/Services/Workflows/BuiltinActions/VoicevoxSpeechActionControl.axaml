<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:actions="clr-namespace:KyoshinEewViewer.Services.Workflows.BuiltinActions;assembly=KyoshinEewViewer"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="actions:VoicevoxSpeechAction" x:CompileBindings="True" xmlns:loc="using:KyoshinEewViewer.Localization"
             x:Class="KyoshinEewViewer.Services.Workflows.BuiltinActions.VoicevoxSpeechActionControl">
    <StackPanel>
        <Grid ColumnDefinitions="auto,*,auto,auto,auto,auto">
            <TextBlock Text="{loc:Tr Sound.VolumeLabel}" Grid.Column="0" VerticalAlignment="Center" />
            <Slider Value="{Binding Volume}" Minimum="0" Maximum="1" TickFrequency=".01" IsSnapToTickEnabled="True" Grid.Column="1" Margin="5,-10" />
            <TextBlock Text="{Binding Volume, StringFormat={}{0:P0}}" Width="50" Grid.Column="2" VerticalAlignment="Center" />
            <CheckBox Content="{loc:Tr PlaySoundAction.01}" IsChecked="{Binding WaitToEnd}" Grid.Column="3"
                      ToolTip.Tip="{loc:Tr VoicevoxSpeechAction.01}" />
            <CheckBox Content="{loc:Tr VoicevoxSpeechAction.02}" IsChecked="{Binding SequentialMode}" Grid.Column="4"
                      ToolTip.Tip="{loc:Tr VoicevoxSpeechAction.03}" />
            <CheckBox Content="{loc:Tr VoicevoxSpeechAction.04}" IsChecked="{Binding InterruptPrevious}" Grid.Column="5"
                      ToolTip.Tip="{loc:Tr VoicevoxSpeechAction.05}" />
        </Grid>

        <TextBlock Text="{loc:Tr VoicevoxSpeechAction.06}" Margin="0,8,0,0" />
        <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" 
                     Text="{Binding TemplateText}" 
                     IsReadOnly="True"
                     IsEnabled="False"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MaxLines="3"
                     Background="{DynamicResource LayerFillColorDefaultBrush}"
                     FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                     FontSize="12" />
            <Button Grid.Column="1" 
                    Content="{loc:Tr Common.Edit}" 
                    Click="EditTemplateButton_Click"
                    Margin="8,0,0,0"
                    VerticalAlignment="Top" />
        </Grid>
    </StackPanel>
</UserControl>
