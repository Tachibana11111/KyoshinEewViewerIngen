<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:actions="clr-namespace:KyoshinEewViewer.Services.Workflows.BuiltinActions;assembly=KyoshinEewViewer"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="actions:WebhookAction" x:CompileBindings="True" xmlns:loc="using:KyoshinEewViewer.Localization"
             x:Class="KyoshinEewViewer.Services.Workflows.BuiltinActions.WebhookActionControl">
    <StackPanel>
        <TextBlock Text="URL" />
        <TextBox Text="{Binding Url}" HorizontalAlignment="Stretch" />
        <StackPanel IsVisible="{Binding CanInjectPointForecast}" Margin="0,5,0,0">
            <CheckBox Content="{loc:Tr WebhookAction.01}" IsChecked="{Binding InjectPointForecast}" />
            <TextBlock Text="{loc:Tr WebhookAction.02}"
                       FontSize="12" TextWrapping="Wrap" Margin="24,0,0,0" />
        </StackPanel>
        <TextBlock Text="{loc:Tr WebhookAction.03}" />
        <TextBlock Text="{Binding LatestResponse}" Margin="5,0" />
    </StackPanel>
</UserControl>
