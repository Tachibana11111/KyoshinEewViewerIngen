<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		     xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:actions="clr-namespace:KyoshinEewViewer.Services.Workflows.BuiltinActions;assembly=KyoshinEewViewer"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="actions:ExecuteFileAction" x:CompileBindings="True" xmlns:loc="using:KyoshinEewViewer.Localization"
             x:Class="KyoshinEewViewer.Services.Workflows.BuiltinActions.ExecuteFileActionControl">
    <StackPanel>
        <Grid ColumnDefinitions="auto,*,auto" RowDefinitions="auto,auto,auto">
            <TextBlock Text="{loc:Tr ExecuteFileAction.01}" VerticalAlignment="Center" />
            <TextBox Text="{Binding FilePath}" Grid.Column="1" ToolTip.Tip="{loc:Tr ExecuteFileAction.02}" />
            <Button Grid.Column="2" Content="{loc:Tr Common.Edit}" Click="EditFilePathTemplateButton_Click" Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Tr ExecuteFileAction.03}" VerticalAlignment="Center" Grid.Row="1" IsVisible="{Binding !UseShellExecute}" />
            <TextBox Text="{Binding Arguments}" Grid.Column="1" Grid.Row="1" IsVisible="{Binding !UseShellExecute}" ToolTip.Tip="{loc:Tr ExecuteFileAction.02}" />
            <Button Grid.Column="2" Grid.Row="1" Content="{loc:Tr Common.Edit}" Click="EditArgumentsTemplateButton_Click" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding !UseShellExecute}" />
            <TextBlock Text="{loc:Tr ExecuteFileAction.04}" VerticalAlignment="Center" Grid.Row="2" />
            <TextBox Text="{Binding WorkingDirectory}" PlaceholderText="未指定の場合はこのアプリのディレクトリが使用されます。" Grid.Column="1" Grid.Row="2" ToolTip.Tip="{loc:Tr ExecuteFileAction.02}" />
            <Button Grid.Column="2" Grid.Row="2" Content="{loc:Tr Common.Edit}" Click="EditWorkingDirectoryTemplateButton_Click" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <CheckBox IsChecked="{Binding UseShellExecute}" Content="{loc:Tr ExecuteFileAction.05}"
                  ToolTip.Tip="{loc:Tr ExecuteFileAction.06}" />
        <CheckBox IsChecked="{Binding WaitToEnd}" Content="{loc:Tr ExecuteFileAction.07}" />
        <TextBlock Text="{loc:Tr ExecuteFileAction.08}" />
        <TextBlock Text="{Binding LatestExecuteResult}" Margin="5,0" />
    </StackPanel>
</UserControl>
